{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prop13-santa-cruz",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "rel.me/case-studies/prop13-santa-cruz*", "zone_name": "rel.me" }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
